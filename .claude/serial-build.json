{
  "version": 1,
  "owner": {
    "name": "Fili"
  },
  "inbox": "claude_outputs",
  "generated": [
    {
      "path": "contracts.toml",
      "regenerate": "uv run python tools/toolkit/render_import_contracts.py project-spec.toml contracts.toml src/uiaudit"
    },
    {
      "path": "docs/api/*",
      "regenerate": "uv run python tools/render_surfaces.py"
    }
  ],
  "checks": {
    "on_edit": [
      {
        "name": "ruff",
        "paths": [
          "src/**",
          "tests/**",
          "tools/**"
        ],
        "run": "uv run ruff check \"$SB_FILE\" && uv run ruff format --check \"$SB_FILE\""
      }
    ],
    "on_stop": [
      {
        "name": "the stop-stage rows of CONSTRAINTS.md",
        "paths": [
          "src/**",
          "tests/**",
          "tools/**",
          "project-spec.toml",
          "contracts.toml",
          "docs/api/**",
          "CONSTRAINTS.md",
          "pyproject.toml"
        ],
        "run": "uv run python tools/check.py --stage stop"
      }
    ]
  },
  "red": {
    "test_paths": [
      "tests/*"
    ]
  }
}
