#!/bin/sh
# commit-msg: the debt ratchet, on the index that is about to be committed and on the working tree,
# reading the message for its "Debt-Raised: <reason>" trailer. The only hook that sees the message.
set -eu
cd "$(git rev-parse --show-toplevel)"
uv run python tools/ratchet.py --staged --message-file "$1"
uv run python tools/ratchet.py --message-file "$1"
