#!/bin/sh
# pre-commit: the rows of CONSTRAINTS.md whose local stage is the commit (the harness gate), through
# the same runner CI uses. Lint runs on edit, the contracts, types, dependencies and tests at the end
# of a turn, everything again at push and in CI, so nothing here repeats a check already run.
set -eu
cd "$(git rev-parse --show-toplevel)"
exec uv run python tools/check.py --stage commit
